FROM python:3.11-slim

WORKDIR /app

# Dependências Python
COPY requirements.txt .
RUN pip install --no-cache-dir \
    "psycopg[binary]" \
    python-dotenv \
    prometheus_client \
    pandas \
    pyarrow \
    pyyaml

# Copiar código do projeto
COPY monitoring/ monitoring/
COPY data/processed/baseline_monitoring.parquet data/processed/baseline_monitoring.parquet

ENV PYTHONUNBUFFERED=1

CMD ["python", "monitoring/exporters/prometheus_exporter.py"]
